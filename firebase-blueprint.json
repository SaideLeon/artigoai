{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile registered via Google Sign-In",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user email address",
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Google profile avatar URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Personal default studio and appearance preferences for a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "tomPadrao": {
          "type": "string",
          "description": "Default writing tone",
          "maxLength": 80
        },
        "idiomaPadrao": {
          "type": "string",
          "description": "Default language",
          "maxLength": 60
        },
        "faixaPalavrasPadrao": {
          "type": "string",
          "enum": ["800-1200", "1200-1800", "2000-2500", "2600-3200"],
          "description": "Default word range"
        },
        "incluirImagensPadrao": {
          "type": "boolean",
          "description": "Include illustrations by default"
        },
        "primeiraPessoaPadrao": {
          "type": "boolean",
          "description": "Write in first person by default"
        },
        "pesquisaWebPadrao": {
          "type": "string",
          "enum": ["auto", "sempre", "desativada"],
          "description": "Default web search mode"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "description": "Preferred UI theme"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "tomPadrao",
        "idiomaPadrao",
        "faixaPalavrasPadrao",
        "incluirImagensPadrao",
        "primeiraPessoaPadrao",
        "pesquisaWebPadrao",
        "theme",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedArticle": {
      "title": "SavedArticle",
      "description": "Generated and user-edited article stored in the user library",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "tema": {
          "type": "string",
          "maxLength": 300
        },
        "titulo": {
          "type": "string",
          "maxLength": 300
        },
        "descricao": {
          "type": "string",
          "maxLength": 1000
        },
        "palavrasChave": {
          "type": "array"
        },
        "tom": {
          "type": "string",
          "maxLength": 80
        },
        "idioma": {
          "type": "string",
          "maxLength": 60
        },
        "faixaPalavras": {
          "type": "string",
          "enum": ["800-1200", "1200-1800", "2000-2500", "2600-3200"]
        },
        "primeiraPessoa": {
          "type": "boolean"
        },
        "pesquisaUsada": {
          "type": "boolean"
        },
        "fontes": {
          "type": "array"
        },
        "secoes": {
          "type": "array"
        },
        "criadoEm": {
          "type": "string",
          "maxLength": 64
        },
        "favorito": {
          "type": "boolean"
        },
        "totalPalavras": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "tema",
        "titulo",
        "descricao",
        "palavrasChave",
        "tom",
        "idioma",
        "faixaPalavras",
        "primeiraPessoa",
        "pesquisaUsada",
        "fontes",
        "secoes",
        "criadoEm",
        "favorito",
        "totalPalavras",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Authenticated user profile document keyed by Firebase Auth UID"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/UserSettings"
      },
      "description": "Personal default studio and appearance preferences for the user"
    },
    "/users/{userId}/articles/{articleId}": {
      "schema": {
        "$ref": "#/entities/SavedArticle"
      },
      "description": "Saved articles belonging to the authenticated user"
    }
  }
}
